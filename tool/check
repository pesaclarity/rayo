#!/usr/bin/env bash
# Everything CI checks that this computer can: the same scripts as
# .github/workflows/ci.yml (tool/ci/).
set -euo pipefail
cd "$(dirname "$0")/.."

tool/ci/models.sh
tool/ci/lint.sh
python3 tool/check_docs.py
tool/ci/examples.sh cc
tool/ci/convert.sh cc
for cc in gcc clang; do
  command -v "$cc" >/dev/null || continue
  tool/ci/test.sh "$cc"
  if [ "$(uname -m)" = x86_64 ]; then
    tool/ci/test.sh "$cc" -msse4.1
    tool/ci/test.sh "$cc" -mavx2 -mfma
  fi
done
if [ "$(uname -m)" = x86_64 ]; then
  tool/ci/sanitize.sh gcc -mavx2 -mfma
else
  tool/ci/sanitize.sh cc
fi
if command -v gcc >/dev/null && command -v clang >/dev/null; then tool/ci/builds.sh; fi
if command -v clang >/dev/null; then
  tool/ci/fuzz.sh replay clang -fsanitize=address,undefined -fno-sanitize-recover=all
  tool/ci/fuzz.sh run 10
  tool/ci/analyze.sh
fi
tool/ci/erf.sh cc
tool/ci/chat.sh cc
if [ -n "${ANDROID_NDK_HOME:-}" ]; then tool/ci/android.sh; fi
if [ -n "${WASI_SDK:-}" ] && command -v "${WASMTIME:-wasmtime}" >/dev/null; then tool/ci/wasm.sh; fi
tool/ci/dart.sh
if command -v flutter >/dev/null; then tool/ci/flutter_example.sh; fi
